{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],

  "minimumReleaseAge": "3 days",

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": "0 days"
  },

  "schedule": ["before 6am on Saturday"],

  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "behind-base-branch",
  "major": {
    "labels": ["dependencies", "breaking-change"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "labels": ["dependencies", "npm"],
    "commitMessageAction": "refresh transitive dependencies",
    "postUpdateOptions": ["npmDedupe"]
  },

  "packageRules": [
    {
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    },
    {
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "groupName": "nextjs",
      "minimumReleaseAge": "5 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "groupName": "nextjs-major"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react-major"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker",
      "addLabels": ["docker"]
    }
  ]
}
